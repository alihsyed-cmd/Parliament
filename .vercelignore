# Vercel's Root Directory is `frontend`, so nothing outside it is used by the
# build. Excluding the rest keeps credentials and pipeline data out of the
# upload and makes deploys fast.
data/
scripts/
docs/
screenshots/
_archive_pre_pipeline/
.claude/
*.zip
*.csv
*.md
cookies.txt
parliamentapp.ca.txt

# Nothing below is used by the build (Root Directory is `frontend`); these are
# excluded so backend secrets and pipeline scratch never enter the upload.
# `.env*` covers the root .env (SUPABASE_DB_URL, GOOGLE_MAPS_API_KEY) and any
# local frontend env file — production values come from the Vercel dashboard.
.env*
yukon_emails.txt
memory/
tests/
migrations/
__pycache__/
*.py
*.sql
*.pptx
