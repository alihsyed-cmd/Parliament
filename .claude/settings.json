{
  "worktree": {
    "bgIsolation": "none"
  },
  "permissions": {
    "allow": [
      "Bash(sleep 2 && curl -s -L *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(awk *)",
      "Bash(echo *)",
      "Bash(date *)",
      "Bash(mkdir *)",
      "Bash(find *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(unzip -l *)",
      "Bash(curl *)",
      "Bash(python3 *)"
    ]
  },
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "Bash|Write|Edit|NotebookEdit|WebFetch|WebSearch|Read|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-/Users/alisyed/Desktop/Parliament}/.claude/hooks/auto_approve.py\"",
            "timeout": 10,
            "statusMessage": "Checking pipeline command policy"
          }
        ]
      }
    ]
  }
}
